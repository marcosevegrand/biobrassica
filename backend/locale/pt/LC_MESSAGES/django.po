msgid "Agricultura Biológica"
msgstr "Agricultura Biológica"

msgid ""
"Saiba como praticamos agricultura biológica certificada no Minho, com "
"respeito pela biodiversidade e pelos ciclos naturais."
msgstr ""
"Saiba como praticamos agricultura biológica certificada no Minho, com "
"respeito pela biodiversidade e pelos ciclos naturais."

msgid "Campo de agricultura biológica"
msgstr "Campo de agricultura biológica"

msgid ""
"A agricultura biológica é um sistema de produção que respeita os ciclos "
"naturais, promove a biodiversidade e proíbe o uso de pesticidas e "
"fertilizantes químicos de síntese. Na Biobrassica, estas práticas são o "
"coração de tudo o que fazemos."
msgstr ""
"A agricultura biológica é um sistema de produção que respeita os ciclos "
"naturais, promove a biodiversidade e proíbe o uso de pesticidas e "
"fertilizantes químicos de síntese. Na Biobrassica, estas práticas são o "
"coração de tudo o que fazemos."

msgid "Os Princípios da Agricultura Bio"
msgstr "Os Princípios da Agricultura Bio"

msgid "Sem pesticidas sintéticos"
msgstr "Sem pesticidas sintéticos"

msgid ""
"Utilizamos apenas métodos naturais de controlo de pragas: insetos "
"auxiliares, rotação de culturas e preparados biológicos."
msgstr ""
"Utilizamos apenas métodos naturais de controlo de pragas: insetos "
"auxiliares, rotação de culturas e preparados biológicos."

msgid "Solo vivo"
msgstr "Solo vivo"

msgid ""
"Alimentamos o solo, não apenas a planta. Compostagem, adubos verdes e "
"coberturas vegetais mantêm a vida microbiana do solo."
msgstr ""
"Alimentamos o solo, não apenas a planta. Compostagem, adubos verdes e "
"coberturas vegetais mantêm a vida microbiana do solo."

msgid "Sem OGM"
msgstr "Sem OGM"

msgid ""
