msgid "Available %s"
msgstr "Disponíveis: %s"

msgid "Chosen %s"
msgstr "Selecionados: %s"

msgid "Choose %s by selecting them and then select the \"Choose\" arrow button."
msgstr "Escolha %s selecionando-os e depois carregando na seta \"Escolher\"."

msgid "Type into this box to filter down the list of available %s."
msgstr "Escreva nesta caixa para filtrar a lista de %s disponíveis."

msgid "Filter"
msgstr "Filtrar"

msgid "Choose all %s"
msgstr "Escolher todos os %s"

msgid "Choose selected %s"
msgstr "Escolher os %s selecionados"

msgid "Remove selected %s"
msgstr "Remover os %s selecionados"

msgid "Remove %s by selecting them and then select the \"Remove\" arrow button."
msgstr "Remova %s selecionando-os e depois carregando na seta \"Remover\"."

msgid "Type into this box to filter down the list of selected %s."
msgstr "Escreva nesta caixa para filtrar a lista de %s selecionados."

msgid "(click to clear)"
msgstr "(clique para limpar)"

msgid "Remove all %s"
msgstr "Remover todos os %s"

msgid "Hold down “Control”, or “Command” on a Mac, to select more than one."
msgstr "Mantenha premida a tecla “Control”, ou “Command” num Mac, para selecionar mais do que um."