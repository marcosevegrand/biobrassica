---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);

const stores = [
  { name: 'Braga', address: 'Avenida Doutor António Palha, Loja 13, Nº15', city: '4715-091 Lamaçães - Braga', phone: '253 271 187', phoneLabel: '253 271 187 (National landline call)', hours: 'Mon-Fri: 9am-7pm | Sat: 9am-2pm', image: 'https://images.unsplash.com/photo-1604719312566-8912e9227c6a?w=800&h=500&fit=crop', mapEmbed: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2984.123456789!2d-8.4269!3d41.5518!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sBraga!5e0!3m2!1sen!2spt!4v1234567890' },
  { name: 'Guimarães', address: 'Rua Calouste Gulbenkian, n.5', city: '4810-257 Guimarães', phone: '253 145 388', phoneLabel: '253 145 388 (National landline call)', hours: 'Mon-Fri: 9am-7pm | Sat: 9am-2pm', image: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&h=500&fit=crop', mapEmbed: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2984.123456789!2d-8.2919!3d41.4425!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sGuimaraes!5e0!3m2!1sen!2spt!4v1234567890' },
];
---

<BaseLayout title={t('contact.title')} lang={lang}>
  <section class="pt-24 pb-8 px-6 max-w-7xl mx-auto text-center"><h1 class="font-serif text-4xl md:text-5xl italic mb-4">{t('contact.title')}</h1></section>
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {stores.map((store) => (
        <div class="border border-stone/40 rounded-sm overflow-hidden bg-paper">
          <img src={store.image} alt={`Biobrassica Store ${store.name}`} class="w-full aspect-[16/9] object-cover" loading="lazy" />
          <div class="p-6 md:p-8">
            <h2 class="font-serif text-2xl italic mb-6">{store.name}</h2>
            <p class="text-sm text-muted mb-2">{store.address}, {store.city}</p>
            <p class="text-sm text-muted mb-2"><strong>{t('contact.hours')}:</strong> {store.hours}</p>
            <p class="text-sm mb-4"><strong>{t('contact.phone')}:</strong> <a href={`tel:${store.phone.replace(/\s/g, '')}`} class="text-terracotta hover:underline">{store.phoneLabel}</a></p>
            <div class="rounded-sm overflow-hidden border border-stone/40"><iframe src={store.mapEmbed} width="100%" height="250" style="border:0;" loading="lazy" title={`Map ${store.name}`}></iframe></div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
