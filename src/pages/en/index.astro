---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroVideo from '../../components/Sections/HeroVideo.astro';
import ProductCard from '../../components/Cards/ProductCard.astro';
import { useTranslations, routes } from '../../i18n/ui';
import { getCollection } from 'astro:content';

const lang = 'en';
const t = useTranslations(lang);
const langRoutes = routes[lang];

const allProducts = await getCollection('products');
const highlights = allProducts.filter((p) => p.data.isHighlight && p.data.lang === lang).slice(0, 4);

const allRecipes = await getCollection('recipes');
const featuredRecipes = allRecipes.filter((r) => r.data.lang === lang).slice(0, 2);
---

<BaseLayout title={t('nav.home')} lang={lang} isLanding={true}>
  <HeroVideo
    title={t('hero.title')}
    subtitle={t('hero.subtitle')}
    image="/photos/image1.jpeg"
  />

  <section class="max-w-7xl mx-auto px-6 py-24">
    <h2 class="font-serif text-3xl md:text-4xl text-center mb-16 italic">{t('harvest.title')}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {highlights.map((product) => (
        <ProductCard
          title={product.data.title}
          category={product.data.category}
          image={product.data.image}
          priceDisplay={product.data.priceDisplay}
          locations={product.data.locations}
          slug={product.id}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <section class="bg-forest text-paper">
    <div class="max-w-7xl mx-auto px-6 py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="overflow-hidden rounded-sm">
          <img
            src="https://images.unsplash.com/photo-1605000797499-95a51c5269ae?w=800&h=1000&fit=crop"
            alt="Hands holding organic vegetables"
            class="w-full aspect-[4/5] object-cover"
          />
        </div>
        <div class="max-w-lg">
          <h2 class="font-serif text-3xl md:text-4xl italic mb-8">{t('philosophy.title')}</h2>
          <p class="text-paper/80 leading-relaxed mb-8 text-base">{t('philosophy.text')}</p>
          <a
            href={langRoutes.about}
            class="inline-block text-xs uppercase tracking-widest border border-paper/60 px-6 py-3 rounded-sm hover:bg-paper hover:text-forest transition-colors"
          >
            {t('philosophy.cta')}
          </a>
        </div>
      </div>
    </div>
  </section>

  {featuredRecipes.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 py-24">
      <h2 class="font-serif text-3xl md:text-4xl text-center mb-16 italic">{t('featured-recipe.title')}</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {featuredRecipes.map((featuredRecipe) => (
          <a href={`${langRoutes.recipes}${featuredRecipe.id}/`} class="group block border border-stone/40 rounded-sm overflow-hidden">
            <div class="overflow-hidden">
              <img
                src={featuredRecipe.data.image}
                alt={featuredRecipe.data.title}
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-8 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-4 text-[10px] uppercase tracking-widest text-muted">
                <span>{featuredRecipe.data.prepTime}</span>
                <span class="w-1 h-1 rounded-full bg-stone"></span>
                <span>{featuredRecipe.data.difficulty}</span>
              </div>
              <h3 class="font-serif text-2xl italic mb-4 group-hover:text-terracotta transition-colors">{featuredRecipe.data.title}</h3>
              <div class="flex flex-wrap gap-1 mb-6">
                {featuredRecipe.data.tags.map((tag: string) => (
                  <span class="text-[10px] uppercase tracking-widest text-terracotta border border-terracotta/30 px-2 py-0.5 rounded-sm">{tag}</span>
                ))}
              </div>
              <span class="text-xs uppercase tracking-widest text-forest group-hover:text-terracotta transition-colors">See recipe →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
