---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/Cards/ProductCard.astro';
import { useTranslations } from '../../../i18n/ui';
import { getCollection, render } from 'astro:content';

const lang = 'en';
const t = useTranslations(lang);

export async function getStaticPaths() {
  const allRecipes = await getCollection('recipes');
  return allRecipes
    .filter((r) => r.data.lang === 'en')
    .map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);

const allProducts = await getCollection('products');
const featuredProducts = allProducts.filter((p) => recipe.data.featuredProducts.includes(p.id) && p.data.lang === lang);
---

<BaseLayout title={recipe.data.title} lang={lang}>
  <section class="relative h-[50vh] min-h-[350px] mt-16 overflow-hidden">
    <img src={recipe.data.image} alt={recipe.data.title} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-forest/60 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-12 max-w-7xl mx-auto">
      <div class="flex items-center gap-3 mb-3 text-[10px] uppercase tracking-widest text-paper/70"><span>{recipe.data.prepTime}</span><span class="w-1 h-1 rounded-full bg-paper/50"></span><span>{recipe.data.difficulty}</span></div>
      <h1 class="font-serif text-3xl md:text-5xl italic text-paper">{recipe.data.title}</h1>
      <div class="flex flex-wrap gap-2 mt-4">{recipe.data.tags.map((tag: string) => (<span class="text-[10px] uppercase tracking-widest text-paper/90 border border-paper/30 px-2 py-0.5 rounded-sm">{tag}</span>))}</div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <aside class="lg:col-span-1">
        <h2 class="font-serif text-2xl italic mb-6 pb-3 border-b border-stone/40">{t('recipes.ingredients')}</h2>
        <ul class="space-y-3">{recipe.data.ingredientsList.map((ingredient: string) => (<li class="flex items-start gap-3 text-sm text-muted"><span class="w-1.5 h-1.5 rounded-full bg-terracotta mt-1.5 shrink-0"></span>{ingredient}</li>))}</ul>
      </aside>
      <div class="lg:col-span-2">
        <h2 class="font-serif text-2xl italic mb-6 pb-3 border-b border-stone/40">{t('recipes.steps')}</h2>
        <div class="prose prose-sm max-w-none text-muted leading-relaxed [&_ol]:space-y-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:text-sm [&_li]:leading-relaxed [&_h2]:font-serif [&_h2]:text-xl [&_h2]:italic [&_h2]:text-forest [&_h2]:mt-8 [&_h2]:mb-4 [&_p]:mb-4"><Content /></div>
      </div>
    </div>
  </section>

  {featuredProducts.length > 0 && (
    <section class="bg-forest/5 py-24">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="font-serif text-3xl italic text-center mb-3">{t('recipes.shopBridge')}</h2>
        <p class="text-muted text-sm text-center mb-12">{t('recipes.shopBridge.text')}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredProducts.map((product) => (<ProductCard title={product.data.title} category={product.data.category} image={product.data.image} priceDisplay={product.data.priceDisplay} locations={product.data.locations} slug={product.id} lang={lang} />))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
