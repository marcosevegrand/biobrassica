---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecipeCard from '../../../components/Cards/RecipeCard.astro';
import { useTranslations } from '../../../i18n/ui';
import { getCollection } from 'astro:content';

const lang = 'en';
const t = useTranslations(lang);
const allRecipes = await getCollection('recipes');
const recipes = allRecipes.filter((r) => r.data.lang === lang);
const allTags = [...new Set(recipes.flatMap((r) => r.data.tags))];
---

<BaseLayout title={t('recipes.title')} lang={lang}>
  <section class="pt-24 pb-8 px-6 max-w-7xl mx-auto text-center">
    <h1 class="font-serif text-4xl md:text-5xl italic mb-4">{t('recipes.title')}</h1>
    <p class="text-muted text-base max-w-xl mx-auto">{t('recipes.subtitle')}</p>
  </section>

  <section class="max-w-7xl mx-auto px-6 mb-12">
    <div class="flex flex-wrap justify-center gap-2" id="tag-filters">
      <button data-tag="all" class="text-[10px] uppercase tracking-widest px-3 py-1.5 border rounded-sm transition-colors cursor-pointer tag-btn bg-terracotta text-paper border-terracotta">All</button>
      {allTags.map((tag) => (<button data-tag={tag} class="text-[10px] uppercase tracking-widest px-3 py-1.5 border border-terracotta/30 text-terracotta rounded-sm transition-colors cursor-pointer tag-btn hover:bg-terracotta hover:text-paper">{tag}</button>))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="recipe-grid">
      {recipes.map((recipe) => (
        <div data-recipe-tags={recipe.data.tags.join(',')}>
          <RecipeCard title={recipe.data.title} image={recipe.data.image} prepTime={recipe.data.prepTime} difficulty={recipe.data.difficulty} tags={recipe.data.tags} slug={recipe.id} lang={lang} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const tagBtns = document.querySelectorAll('.tag-btn');
  const recipeItems = document.querySelectorAll('[data-recipe-tags]');
  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = (btn as HTMLElement).dataset.tag;
      tagBtns.forEach(b => { b.classList.remove('bg-terracotta', 'text-paper', 'border-terracotta'); b.classList.add('border-terracotta/30', 'text-terracotta'); });
      btn.classList.add('bg-terracotta', 'text-paper', 'border-terracotta');
      btn.classList.remove('border-terracotta/30', 'text-terracotta');
      recipeItems.forEach(item => {
        const el = item as HTMLElement;
        const tags = el.dataset.recipeTags?.split(',') || [];
        if (tag === 'all' || tags.includes(tag!)) el.style.display = '';
        else el.style.display = 'none';
      });
    });
  });
</script>
