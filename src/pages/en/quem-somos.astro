---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, withBase } from '../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);

const timeline = [
  { year: '2015', title: 'The Seed', text: 'We started with a small field in Braga, driven by our passion for the land and healthy food.' },
  { year: '2017', title: 'Organic Certification', text: 'We received Certiplanet organic certification, validating our commitment to sustainable farming practices.' },
  { year: '2019', title: 'Opening in Braga', text: 'We opened our first physical store in Braga, bringing fresh produce directly from the farm to families.' },
  { year: '2022', title: 'Expansion to Guimarães', text: 'With growing demand, we opened our second store in Guimarães, strengthening our local presence.' },
  { year: '2025', title: 'The Future is Organic', text: 'We continue to grow, expanding our offer and strengthening partnerships with regional producers.' },
];

const storyBlocks = [
  {
    title: 'What Biobrassica means',
    text: 'The name Biobrassica brings together two ideas that guide everything we do: Bio, for organic farming and responsible production, and brassica, as a tribute to the vegetable family that reflects our agricultural roots.',
    image: withBase('favicon_green.png'),
    alt: 'Organic farm field',
    fit: 'contain',
  },
  {
    title: 'How we select products',
    text: 'We select seasonal products, prioritizing produce from our own organic farm and local growers whose practices align with our values. We assess freshness, origin, farming method, and consistency to ensure an honest and flavorful offer throughout the year.',
    image: 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=1200&h=800&fit=crop',
    alt: 'Selection of fresh products',
  },
  {
    title: 'How we ensure quality',
    text: 'Quality is monitored at every stage: crop planning, harvest timing, careful transport, and daily in-store checks. We maintain organic certification and internal traceability standards so each product arrives fresh, safe, and with a clear origin.',
    image: 'https://images.unsplash.com/photo-1501004318641-b39e6451bec6?w=1200&h=800&fit=crop',
    alt: 'Vegetable harvest on the farm',
  },
  {
    title: 'Our organic farm',
    text: 'Our organic farm is the heart of Biobrassica. We work with respect for soil, biodiversity, and natural cycles, reducing environmental impact while promoting regenerative practices. It is where we grow the foundation of many products sold in our Braga and Guimarães stores.',
    image: withBase('photos/quinta-joaquim.jpg'),
    alt: 'Biobrassica organic farm',
  },
];
---

<BaseLayout title={t('about.hero.title')} lang={lang}>
  <section class="relative h-[75vh] min-h-[520px] flex items-center justify-center overflow-hidden mt-16">
    <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline preload="metadata" aria-label="Biobrassica video">
      <source src={withBase('videos/video_brassica.mp4')} type="video/mp4" />
    </video>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-24">
    <div class="space-y-16">
      {storyBlocks.map((block, i) => (
        <article class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
          <div class:list={['space-y-4', { 'md:order-2': i % 2 !== 0 }]}>
            <h2 class="font-serif text-3xl md:text-4xl italic">{block.title}</h2>
            <p class="text-muted leading-relaxed">{block.text}</p>
          </div>
          <div class:list={['border border-stone/40 rounded-sm overflow-hidden', { 'md:order-1': i % 2 !== 0 }]}>
            <img
              src={block.image}
              alt={block.alt}
              class:list={[
                'w-full aspect-[4/3] bg-paper',
                { 'object-contain': block.fit === 'contain', 'object-cover': block.fit !== 'contain' },
              ]}
              loading="lazy"
            />
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-24">
    <h2 class="font-serif text-3xl md:text-4xl text-center italic mb-16">{t('about.timeline.title')}</h2>
    <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-stone/60 -translate-x-1/2"></div>
      <div class="space-y-16">
        {timeline.map((item, i) => (
          <div class:list={["relative flex flex-col md:flex-row items-start gap-8", { 'md:flex-row-reverse': i % 2 !== 0 }]}>
            <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-terracotta rounded-full -translate-x-1/2 mt-1 z-10"></div>
            <div class:list={["ml-12 md:ml-0 md:w-1/2", { 'md:pr-16 md:text-right': i % 2 === 0, 'md:pl-16': i % 2 !== 0 }]}>
              <span class="text-terracotta text-sm font-medium tracking-wide">{item.year}</span>
              <h3 class="font-serif text-xl italic mt-1 mb-2">{item.title}</h3>
              <p class="text-muted text-sm leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-forest/5 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-serif text-3xl md:text-4xl text-center italic mb-16">{t('about.values.title')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="text-center"><h3 class="font-serif text-xl italic mb-3">{t('about.values.earth')}</h3><p class="text-muted text-sm leading-relaxed">{t('about.values.earth.text')}</p></div>
        <div class="text-center"><h3 class="font-serif text-xl italic mb-3">{t('about.values.community')}</h3><p class="text-muted text-sm leading-relaxed">{t('about.values.community.text')}</p></div>
        <div class="text-center"><h3 class="font-serif text-xl italic mb-3">{t('about.values.health')}</h3><p class="text-muted text-sm leading-relaxed">{t('about.values.health.text')}</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
