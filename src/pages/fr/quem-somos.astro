---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, withBase } from '../../i18n/ui';

const lang = 'fr';
const t = useTranslations(lang);

const timeline = [
  { year: '2015', title: 'La Graine', text: 'Nous avons commencé avec un petit terrain à Braga, guidés par notre passion pour la terre et une alimentation saine.' },
  { year: '2017', title: 'Certification Biologique', text: 'Nous avons reçu la certification biologique Certiplanet, confirmant notre engagement envers des pratiques durables.' },
  { year: '2019', title: 'Ouverture à Braga', text: 'Nous avons ouvert notre première boutique à Braga, reliant directement la ferme aux familles.' },
  { year: '2022', title: 'Expansion à Guimarães', text: 'Avec la demande croissante, nous avons ouvert une seconde boutique à Guimarães.' },
  { year: '2025', title: 'L’Avenir est Bio', text: 'Nous continuons de grandir et de renforcer nos partenariats avec les producteurs locaux.' },
];

const storyBlocks = [
  {
    title: 'Que signifie Biobrassica',
    text: 'Le nom Biobrassica réunit deux idées qui guident tout notre travail : Bio, pour l’agriculture biologique et une production responsable, et brassica, en hommage à la famille de légumes qui symbolise nos racines agricoles.',
    image: withBase('favicon_green.png'),
    alt: 'Champ agricole biologique',
    fit: 'contain',
  },
  {
    title: 'Comment nous sélectionnons les produits',
    text: 'Nous sélectionnons des produits de saison, en privilégiant ceux de notre ferme biologique et de producteurs locaux dont les pratiques sont alignées avec nos valeurs. Nous évaluons la fraîcheur, l’origine, le mode de production et la régularité afin de garantir une offre sincère et savoureuse toute l’année.',
    image: 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=1200&h=800&fit=crop',
    alt: 'Sélection de produits frais',
  },
  {
    title: 'Comment nous garantissons la qualité',
    text: 'La qualité est suivie à chaque étape : planification des cultures, récolte au bon moment, transport soigné et contrôle quotidien en boutique. Nous maintenons la certification biologique et des critères internes de traçabilité pour que chaque produit arrive frais, sûr et avec une origine claire.',
    image: 'https://images.unsplash.com/photo-1501004318641-b39e6451bec6?w=1200&h=800&fit=crop',
    alt: 'Récolte de légumes à la ferme',
  },
  {
    title: 'Notre ferme biologique',
    text: 'Notre ferme biologique est le cœur de Biobrassica. Nous travaillons dans le respect des sols, de la biodiversité et des cycles naturels, en réduisant l’impact environnemental et en favorisant des pratiques régénératives. C’est là que nous cultivons la base de nombreux produits vendus dans nos boutiques de Braga et Guimarães.',
    image: withBase('photos/quinta-joaquim.jpg'),
    alt: 'Ferme biologique Biobrassica',
  },
];
---

<BaseLayout title={t('about.hero.title')} lang={lang}>
  <section class="relative h-[75vh] min-h-[520px] flex items-center justify-center overflow-hidden mt-16">
    <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline preload="metadata" aria-label="Vidéo Biobrassica">
      <source src={withBase('videos/video_brassica.mp4')} type="video/mp4" />
    </video>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-24">
    <div class="space-y-16">
      {storyBlocks.map((block, i) => (
        <article class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
          <div class:list={['space-y-4', { 'md:order-2': i % 2 !== 0 }]}>
            <h2 class="font-serif text-3xl md:text-4xl italic">{block.title}</h2>
            <p class="text-muted leading-relaxed">{block.text}</p>
          </div>
          <div class:list={['border border-stone/40 rounded-sm overflow-hidden', { 'md:order-1': i % 2 !== 0 }]}>
            <img
              src={block.image}
              alt={block.alt}
              class:list={[
                'w-full aspect-[4/3] bg-paper',
                { 'object-contain': block.fit === 'contain', 'object-cover': block.fit !== 'contain' },
              ]}
              loading="lazy"
            />
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-24">
    <h2 class="font-serif text-3xl md:text-4xl text-center italic mb-16">{t('about.timeline.title')}</h2>
    <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-stone/60 -translate-x-1/2"></div>
      <div class="space-y-16">
        {timeline.map((item, i) => (
          <div class:list={["relative flex flex-col md:flex-row items-start gap-8", { 'md:flex-row-reverse': i % 2 !== 0 }]}>
            <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-terracotta rounded-full -translate-x-1/2 mt-1 z-10"></div>
            <div class:list={["ml-12 md:ml-0 md:w-1/2", { 'md:pr-16 md:text-right': i % 2 === 0, 'md:pl-16': i % 2 !== 0 }]}>
              <span class="text-terracotta text-sm font-medium tracking-wide">{item.year}</span>
              <h3 class="font-serif text-xl italic mt-1 mb-2">{item.title}</h3>
              <p class="text-muted text-sm leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-forest/5 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-serif text-3xl md:text-4xl text-center italic mb-16">{t('about.values.title')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="text-center"><h3 class="font-serif text-xl italic mb-3">{t('about.values.earth')}</h3><p class="text-muted text-sm leading-relaxed">{t('about.values.earth.text')}</p></div>
        <div class="text-center"><h3 class="font-serif text-xl italic mb-3">{t('about.values.community')}</h3><p class="text-muted text-sm leading-relaxed">{t('about.values.community.text')}</p></div>
        <div class="text-center"><h3 class="font-serif text-xl italic mb-3">{t('about.values.health')}</h3><p class="text-muted text-sm leading-relaxed">{t('about.values.health.text')}</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
