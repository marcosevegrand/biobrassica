---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroVideo from '../../components/Sections/HeroVideo.astro';
import ProductCard from '../../components/Cards/ProductCard.astro';
import { useTranslations, routes, withBase } from '../../i18n/ui';
import { getCollection } from 'astro:content';
import { getInstagramPosts, type InstagramPost } from '../../lib/instagram';

const lang = 'pt';
const t = useTranslations(lang);
const langRoutes = routes[lang];

// Get highlighted products
const allProducts = await getCollection('products');
const highlights = allProducts.filter(p => p.data.isHighlight && p.data.lang === lang).slice(0, 4);

// Get featured recipe
const allRecipes = await getCollection('recipes');
const featuredRecipes = allRecipes.filter(r => r.data.lang === lang).slice(0, 2);

let instagramPosts: InstagramPost[] = await getInstagramPosts(6);

if (instagramPosts.length === 0) {
  instagramPosts = [
    { url: 'https://www.instagram.com/biobrassica/', image: 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=600&h=600&fit=crop', caption: 'Instagram Biobrassica' },
    { url: 'https://www.instagram.com/biobrassica/', image: 'https://images.unsplash.com/photo-1464226184884-fa280b87c399?w=600&h=600&fit=crop', caption: 'Instagram Biobrassica' },
    { url: 'https://www.instagram.com/biobrassica/', image: 'https://images.unsplash.com/photo-1574323347407-f5e1ad6d020b?w=600&h=600&fit=crop', caption: 'Instagram Biobrassica' },
    { url: 'https://www.instagram.com/biobrassica/', image: 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=600&h=600&fit=crop', caption: 'Instagram Biobrassica' },
    { url: 'https://www.instagram.com/biobrassica/', image: 'https://images.unsplash.com/photo-1488459716781-31db52582fe9?w=600&h=600&fit=crop', caption: 'Instagram Biobrassica' },
    { url: 'https://www.instagram.com/biobrassica/', image: 'https://images.unsplash.com/photo-1595855759920-86582396756a?w=600&h=600&fit=crop', caption: 'Instagram Biobrassica' },
  ];
}
---

<BaseLayout title={t('nav.home')} lang={lang} isLanding={true}>

  <!-- Hero -->
  <HeroVideo
    title={t('hero.title')}
    subtitle={t('hero.subtitle')}
    image="/photos/image1.jpeg"
  />

  <!-- Colheita da Semana -->
  <section class="max-w-7xl mx-auto px-6 py-24">
    <h2 class="font-serif text-3xl md:text-4xl text-center mb-16 italic">{t('harvest.title')}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {highlights.map((product) => (
        <ProductCard
          title={product.data.title}
          category={product.data.category}
          image={product.data.image}
          priceDisplay={product.data.priceDisplay}
          locations={product.data.locations}
          slug={product.id}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <!-- Os Nossos Valores -->
  <section class="bg-forest text-paper py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="overflow-hidden rounded-sm">
          <img
            src={withBase('photos/legumes-mulher-2.jpg')}
            alt="Mulher com legumes biológicos"
            class="w-full aspect-[4/5] object-cover"
          />
        </div>

        <div>
          <h2 class="font-serif text-3xl md:text-4xl italic mb-10">{t('about.values.title')}</h2>

          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-full bg-paper/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-paper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif text-xl italic mb-2">{t('about.values.earth')}</h3>
                <p class="text-paper/80 text-sm leading-relaxed">{t('about.values.earth.text')}</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-full bg-paper/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-paper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif text-xl italic mb-2">{t('about.values.community')}</h3>
                <p class="text-paper/80 text-sm leading-relaxed">{t('about.values.community.text')}</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-full bg-paper/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-paper" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif text-xl italic mb-2">{t('about.values.health')}</h3>
                <p class="text-paper/80 text-sm leading-relaxed">{t('about.values.health.text')}</p>
              </div>
            </div>
          </div>

          <a
            href={langRoutes.about}
            class="inline-block mt-10 text-xs uppercase tracking-widest border border-paper/60 px-6 py-3 rounded-sm hover:bg-paper hover:text-forest transition-colors"
          >
            {t('philosophy.cta')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Receita em Destaque -->
  {featuredRecipes.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 py-24">
      <h2 class="font-serif text-3xl md:text-4xl text-center mb-16 italic">{t('featured-recipe.title')}</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {featuredRecipes.map((featuredRecipe) => (
          <a href={`${langRoutes.recipes}${featuredRecipe.id}/`} class="group block border border-stone/40 rounded-sm overflow-hidden">
            <div class="overflow-hidden">
              <img
                src={featuredRecipe.data.image}
                alt={featuredRecipe.data.title}
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-8 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-4 text-[10px] uppercase tracking-widest text-muted">
                <span>{featuredRecipe.data.prepTime}</span>
                <span class="w-1 h-1 rounded-full bg-stone"></span>
                <span>{featuredRecipe.data.difficulty}</span>
              </div>
              <h3 class="font-serif text-2xl italic mb-4 group-hover:text-terracotta transition-colors">
                {featuredRecipe.data.title}
              </h3>
              <div class="flex flex-wrap gap-1 mb-6">
                {featuredRecipe.data.tags.map((tag: string) => (
                  <span class="text-[10px] uppercase tracking-widest text-terracotta border border-terracotta/30 px-2 py-0.5 rounded-sm">
                    {tag}
                  </span>
                ))}
              </div>
              <span class="text-xs uppercase tracking-widest text-forest group-hover:text-terracotta transition-colors">
                Ver receita →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Instagram -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="flex items-center justify-between mb-8">
      <h2 class="font-serif text-3xl md:text-4xl italic">Instagram</h2>
      <a
        href="https://www.instagram.com/biobrassica/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs uppercase tracking-widest text-forest hover:text-terracotta transition-colors"
      >
        @biobrassica
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-2">
      {instagramPosts.map((post) => (
        <a
          href={post.url}
          target="_blank"
          rel="noopener noreferrer"
          class="block overflow-hidden group"
        >
          <img
            src={post.image}
            alt={post.caption}
            class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </a>
      ))}
    </div>
  </section>

</BaseLayout>
