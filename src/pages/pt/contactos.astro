---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, withBase } from '../../i18n/ui';

const lang = 'pt';
const t = useTranslations(lang);

const stores = [
  {
    name: 'Braga',
    address: 'Avenida Doutor António Palha, Loja 13, Nº15',
    city: '4715-091 Lamaçães - Braga',
    phone: '253 271 187',
    phoneLabel: '253 271 187 (Chamada para rede fixa nacional)',
    hours: 'Seg-Sex: 9h-19h | Sáb: 9h-14h',
    image: withBase('photos/loja-braga.png'),
    mapEmbed: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2984.123456789!2d-8.4269!3d41.5518!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sBraga!5e0!3m2!1spt-PT!2spt!4v1234567890',
  },
  {
    name: 'Guimarães',
    address: 'Rua Calouste Gulbenkian, n.5',
    city: '4810-257 Guimarães',
    phone: '253 145 388',
    phoneLabel: '253 145 388 (Chamada para rede fixa nacional)',
    hours: 'Seg-Sex: 9h-19h | Sáb: 9h-14h',
    image: withBase('photos/loja-guima.png'),
    mapEmbed: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2984.123456789!2d-8.2919!3d41.4425!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sGuimaraes!5e0!3m2!1spt-PT!2spt!4v1234567890',
  },
];
---

<BaseLayout title={t('contact.title')} lang={lang}>

  <!-- Hero -->
  <section class="pt-24 pb-8 px-6 max-w-7xl mx-auto text-center">
    <h1 class="font-serif text-4xl md:text-5xl italic mb-4">{t('contact.title')}</h1>
  </section>

  <!-- Stores -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {stores.map((store) => (
        <div class="border border-stone/40 rounded-sm overflow-hidden bg-paper">
          <!-- Store Image -->
          <div class="overflow-hidden">
            <img
              src={store.image}
              alt={`Loja Biobrassica ${store.name}`}
              class="w-full aspect-[16/9] object-cover"
              loading="lazy"
            />
          </div>

          <!-- Store Info -->
          <div class="p-6 md:p-8">
            <h2 class="font-serif text-2xl italic mb-6">{store.name}</h2>

            <div class="space-y-4 mb-6">
              <!-- Address -->
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-terracotta shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <div class="text-sm text-muted">
                  <p>{store.address}</p>
                  <p>{store.city}</p>
                </div>
              </div>

              <!-- Hours -->
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-terracotta shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="text-sm text-muted">
                  <p class="text-xs uppercase tracking-widest text-forest mb-1">{t('contact.hours')}</p>
                  <p>{store.hours}</p>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-terracotta shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                <div class="text-sm">
                  <p class="text-xs uppercase tracking-widest text-forest mb-1">{t('contact.phone')}</p>
                  <a href={`tel:${store.phone.replace(/\s/g, '')}`} class="text-terracotta hover:underline">{store.phoneLabel}</a>
                </div>
              </div>
            </div>

            <!-- Map -->
            <div class="rounded-sm overflow-hidden border border-stone/40">
              <iframe
                src={store.mapEmbed}
                width="100%"
                height="250"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`Mapa ${store.name}`}
              ></iframe>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- WhatsApp CTA -->
    <div class="mt-16 text-center">
      <a
        href="https://wa.me/351900000000?text=Ol%C3%A1%2C%20gostaria%20de%20saber%20mais%20sobre%20a%20Biobrassica!"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#25D366] text-white px-8 py-4 rounded-sm hover:bg-[#20BD5C] transition-colors text-sm uppercase tracking-widest"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {t('contact.whatsapp')}
      </a>
    </div>
  </section>

</BaseLayout>
