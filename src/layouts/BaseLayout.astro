---
import Navbar from '../components/Global/Navbar.astro';
import Footer from '../components/Global/Footer.astro';
import { withBase } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  isLanding?: boolean;
}

const { title, description = 'Biobrassica — Cultivo biológico em Braga & Guimarães', lang = 'pt', isLanding = false } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={withBase('favicon_green.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
    <title>{title} — Biobrassica</title>
  </head>
  <body class="bg-paper text-forest antialiased">
    <Navbar lang={lang} isLanding={isLanding} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
