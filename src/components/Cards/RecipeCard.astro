---
import { routes } from '../../i18n/ui';

interface Props {
  title: string;
  image: string;
  prepTime: string;
  difficulty: string;
  tags: string[];
  slug: string;
  lang: string;
}

const { title, image, prepTime, difficulty, tags, slug, lang } = Astro.props;
---

<a href={`${routes[lang as keyof typeof routes].recipes}${slug}/`} class="group block border border-stone/40 rounded-sm overflow-hidden bg-paper">
  <div class="overflow-hidden">
    <img
      src={image}
      alt={title}
      class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  </div>
  <div class="p-4">
    <div class="flex items-center gap-3 mb-2 text-[10px] uppercase tracking-widest text-muted">
      <span>{prepTime}</span>
      <span class="w-1 h-1 rounded-full bg-stone"></span>
      <span>{difficulty}</span>
    </div>
    <h3 class="font-serif text-lg mb-3 group-hover:text-terracotta transition-colors">{title}</h3>
    <div class="flex flex-wrap gap-1">
      {tags.map((tag) => (
        <span class="text-[10px] uppercase tracking-widest text-terracotta border border-terracotta/30 px-2 py-0.5 rounded-sm">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>
