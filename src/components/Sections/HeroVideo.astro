---
import { withBase } from '../../i18n/ui';

// Hero section with fullscreen video background
interface Props {
  title: string;
  subtitle: string;
  image?: string;
}

const {
  title,
  subtitle,
  image = 'https://images.unsplash.com/photo-1464226184884-fa280b87c399?w=1920&h=1080&fit=crop'
} = Astro.props;
const heroImage = image.startsWith('/') ? withBase(image) : image;
---

<section class="relative h-screen flex items-center justify-center overflow-hidden">
  <img
    src={heroImage}
    alt="Biobrassica farm"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
  />

  <!-- Content -->
  <div class="relative z-10 text-center text-paper px-6 max-w-3xl">
    <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl italic leading-tight mb-6">
      {title}
    </h1>
    <p class="text-sm md:text-base uppercase tracking-widest text-paper/80">
      {subtitle}
    </p>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
    <div class="w-5 h-8 border-2 border-paper/50 rounded-full flex items-start justify-center p-1">
      <div class="w-1 h-2 bg-paper/80 rounded-full animate-bounce"></div>
    </div>
  </div>
</section>
