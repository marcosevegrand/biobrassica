---
import { useTranslations, routes, languages, withBase } from '../../i18n/ui';

interface Props {
  lang: string;
  isLanding?: boolean;
}

const { lang, isLanding = false } = Astro.props;
const t = useTranslations(lang as keyof typeof routes);
const langRoutes = routes[lang as keyof typeof routes];
const currentPath = Astro.url.pathname;
const logoWhite = withBase('logo-white-no-bg.png');
const logoDark = withBase('logo-green-no-bg.png');
---

<header
  id="site-header"
  class:list={[
    "fixed top-0 left-0 right-0 z-50 transition-all duration-300",
    'bg-forest text-paper'
  ]}
>
  <nav class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href={langRoutes.home} class="block">
      <img
        src={logoWhite}
        alt="Biobrassica"
        class="h-16 w-auto transition-all duration-300"
        id="nav-logo"
        data-logo-white={logoWhite}
        data-logo-dark={logoDark}
      />
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden lg:flex items-center gap-8" id="nav-links">
      <li>
        <a href={langRoutes.home}
          class:list={["text-sm uppercase tracking-widest transition-colors nav-link text-paper/80 hover:text-paper", { 'font-medium': currentPath === langRoutes.home }]}>
          {t('nav.home')}
        </a>
      </li>
      <li>
        <a href={langRoutes.about}
          class:list={["text-sm uppercase tracking-widest transition-colors nav-link text-paper/80 hover:text-paper", { 'font-medium': currentPath.includes('quem-somos') }]}>
          {t('nav.about')}
        </a>
      </li>
      <li>
        <a href={langRoutes.agriculture}
          class:list={["text-sm uppercase tracking-widest transition-colors nav-link text-paper/80 hover:text-paper", { 'font-medium': currentPath.includes('agricultura-bio') }]}>
          {t('nav.agriculture')}
        </a>
      </li>
      <li>
        <a href={langRoutes.shop}
          class:list={["text-sm uppercase tracking-widest transition-colors nav-link text-paper/80 hover:text-paper", { 'font-medium': currentPath.includes('loja') }]}>
          {t('nav.shop')}
        </a>
      </li>
      <li>
        <a href={langRoutes.recipes}
          class:list={["text-sm uppercase tracking-widest transition-colors nav-link text-paper/80 hover:text-paper", { 'font-medium': currentPath.includes('receitas') }]}>
          {t('nav.recipes')}
        </a>
      </li>
      <li>
        <a href={langRoutes.contact}
          class:list={["text-sm uppercase tracking-widest transition-colors nav-link text-paper/80 hover:text-paper", { 'font-medium': currentPath.includes('contactos') }]}>
          {t('nav.contact')}
        </a>
      </li>
    </ul>

    <!-- Language Switcher + Mobile Toggle -->
    <div class="flex items-center gap-4">
      <!-- Language Switcher -->
      <div class="flex items-center gap-1 text-xs uppercase tracking-widest" id="lang-switcher">
        {Object.keys(languages).map((l, i) => (
          <Fragment>
            {i > 0 && <span class="text-paper/40">|</span>}
            <a
              href={routes[l as keyof typeof routes].home}
              class:list={["transition-colors lang-link text-paper/60 hover:text-paper", { 'font-medium': l === lang, '!text-paper': l === lang }]}
            >
              {l.toUpperCase()}
            </a>
          </Fragment>
        ))}
      </div>

      <!-- Mobile Hamburger -->
      <button id="mobile-menu-btn" class="lg:hidden flex flex-col gap-1.5 p-1" aria-label="Toggle menu">
        <span class="block w-6 h-0.5 transition-transform bg-paper" id="hamburger-top"></span>
        <span class="block w-6 h-0.5 transition-opacity bg-paper" id="hamburger-mid"></span>
        <span class="block w-6 h-0.5 transition-transform bg-paper" id="hamburger-bot"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-paper border-t border-stone/30">
    <ul class="flex flex-col items-center gap-6 py-8">
      <li><a href={langRoutes.home} class="text-sm uppercase tracking-widest hover:text-terracotta transition-colors">{t('nav.home')}</a></li>
      <li><a href={langRoutes.about} class="text-sm uppercase tracking-widest hover:text-terracotta transition-colors">{t('nav.about')}</a></li>
      <li><a href={langRoutes.agriculture} class="text-sm uppercase tracking-widest hover:text-terracotta transition-colors">{t('nav.agriculture')}</a></li>
      <li><a href={langRoutes.shop} class="text-sm uppercase tracking-widest hover:text-terracotta transition-colors">{t('nav.shop')}</a></li>
      <li><a href={langRoutes.recipes} class="text-sm uppercase tracking-widest hover:text-terracotta transition-colors">{t('nav.recipes')}</a></li>
      <li><a href={langRoutes.contact} class="text-sm uppercase tracking-widest hover:text-terracotta transition-colors">{t('nav.contact')}</a></li>
    </ul>
  </div>
</header>

<script>
  // Scroll detection for header background
  const header = document.getElementById('site-header');
  const logo = document.getElementById('nav-logo') as HTMLImageElement | null;
  const navLinks = document.querySelectorAll('.nav-link');
  const langLinks = document.querySelectorAll('.lang-link');
  const hamburgerBars = document.querySelectorAll('#hamburger-top, #hamburger-mid, #hamburger-bot');

  function updateHeader() {
    if (window.scrollY > 50) {
      // Scrolled: switch to paper background with dark text
      header?.classList.remove('bg-forest', 'text-paper');
      header?.classList.add('bg-paper', 'text-forest', 'shadow-sm');
      if (logo?.dataset.logoDark) logo.src = logo.dataset.logoDark;
      navLinks.forEach(link => {
        link.classList.remove('text-paper/80', 'hover:text-paper');
        link.classList.add('text-forest', 'hover:text-terracotta');
      });
      langLinks.forEach(link => {
        link.classList.remove('text-paper/60', 'hover:text-paper', '!text-paper');
        link.classList.add('hover:text-terracotta');
      });
      hamburgerBars.forEach(bar => {
        bar.classList.remove('bg-paper');
        bar.classList.add('bg-forest');
      });
    } else {
      // At top: brown background with white text
      header?.classList.add('bg-forest', 'text-paper');
      header?.classList.remove('bg-paper', 'text-forest', 'shadow-sm');
      if (logo?.dataset.logoWhite) logo.src = logo.dataset.logoWhite;
      navLinks.forEach(link => {
        link.classList.add('text-paper/80', 'hover:text-paper');
        link.classList.remove('text-forest', 'hover:text-terracotta');
      });
      langLinks.forEach(link => {
        link.classList.add('text-paper/60', 'hover:text-paper');
        link.classList.remove('hover:text-terracotta');
      });
      hamburgerBars.forEach(bar => {
        bar.classList.add('bg-paper');
        bar.classList.remove('bg-forest');
      });
    }
  }
  window.addEventListener('scroll', updateHeader);
  updateHeader();

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerTop = document.getElementById('hamburger-top');
  const hamburgerMid = document.getElementById('hamburger-mid');
  const hamburgerBot = document.getElementById('hamburger-bot');
  let isOpen = false;

  menuBtn?.addEventListener('click', () => {
    isOpen = !isOpen;
    mobileMenu?.classList.toggle('hidden');
    if (isOpen) {
      hamburgerTop!.style.transform = 'rotate(45deg) translate(3px, 3px)';
      hamburgerMid!.style.opacity = '0';
      hamburgerBot!.style.transform = 'rotate(-45deg) translate(3px, -3px)';
    } else {
      hamburgerTop!.style.transform = '';
      hamburgerMid!.style.opacity = '';
      hamburgerBot!.style.transform = '';
    }
  });
</script>
