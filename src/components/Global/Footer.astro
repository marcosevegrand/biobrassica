---
import { useTranslations, routes, withBase } from '../../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as keyof typeof routes);
const langRoutes = routes[lang as keyof typeof routes];
const storesLabel = lang === 'pt' ? 'Lojas' : lang === 'fr' ? 'Boutiques' : 'Stores';
const socialLabel = lang === 'pt' ? 'Redes sociais' : lang === 'fr' ? 'Réseaux sociaux' : 'Social media';
const brandText = 'Produtos biológicos, saudável para si, bons para o ambiente.';

const socialLinks = {
  instagram: 'https://www.instagram.com/biobrassica/',
  facebook: 'https://www.facebook.com/biobrassica',
  whatsapp: 'https://wa.me/351900000000',
};
---

<footer class="bg-forest text-paper">
  <!-- Footer Content -->
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div>
        <img src={withBase('logo-white-no-bg.png')} alt="Biobrassica" class="h-16 w-auto mb-4" />
        <p class="text-paper/70 text-sm leading-relaxed">
          {brandText}
        </p>
        <div class="mt-6 flex items-center gap-3 rounded-sm bg-paper p-2 w-fit">
          <img src={withBase('certiplanet.png')} alt="Certiplanet" class="h-10 w-auto" loading="lazy" />
          <img src={withBase('cert-bio.jpeg')} alt="Certificação Biológica" class="h-10 w-auto" loading="lazy" />
        </div>
      </div>

      <!-- Stores -->
      <div>
        <h4 class="text-xs uppercase tracking-widest mb-4 text-paper/50">{storesLabel}</h4>
        <div class="space-y-4 text-sm text-paper/70">
          <div>
            <p class="text-paper font-medium">Braga</p>
            <p>Avenida Doutor António Palha, Loja 13, Nº15</p>
            <p>4715-091 Lamaçães - Braga</p>
            <p>253 271 187</p>
          </div>
          <div>
            <p class="text-paper font-medium">Guimarães</p>
            <p>Rua Calouste Gulbenkian, n.5</p>
            <p>4810-257 Guimarães</p>
            <p>253 145 388</p>
          </div>
        </div>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-xs uppercase tracking-widest mb-4 text-paper/50">Links</h4>
        <ul class="space-y-2 text-sm text-paper/70">
          <li><a href={langRoutes.about} class="hover:text-paper transition-colors">{t('nav.about')}</a></li>
          <li><a href={langRoutes.shop} class="hover:text-paper transition-colors">{t('nav.shop')}</a></li>
          <li><a href={langRoutes.recipes} class="hover:text-paper transition-colors">{t('nav.recipes')}</a></li>
          <li><a href={langRoutes.contact} class="hover:text-paper transition-colors">{t('nav.contact')}</a></li>
        </ul>

        <div class="mt-6">
          <p class="text-xs uppercase tracking-widest mb-3 text-paper/50">{socialLabel}</p>
          <div class="flex items-center gap-3">
            <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-paper/70 hover:text-paper transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2ZM12 7.5A4.5 4.5 0 1 0 16.5 12 4.5 4.5 0 0 0 12 7.5Zm0 1.5A3 3 0 1 1 9 12a3 3 0 0 1 3-3Zm5.13-2.38a1.12 1.12 0 1 0 1.12 1.12 1.12 1.12 0 0 0-1.12-1.12Z"/>
              </svg>
            </a>

            <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-paper/70 hover:text-paper transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.6 1.7-1.6h1.5V4.8c-.3 0-1.2-.1-2.4-.1-2.4 0-4 1.4-4 4.1V11H8v3h2.3v8h3.2Z"/>
              </svg>
            </a>

            <a href={socialLinks.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-paper/70 hover:text-paper transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                <path d="M12.04 2a10 10 0 0 0-8.65 15L2 22l5.15-1.35A10 10 0 1 0 12.04 2Zm0 18.2a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.05.8.82-2.97-.2-.3a8.2 8.2 0 1 1 6.9 3.79Zm4.5-6.15c-.25-.13-1.49-.74-1.72-.82s-.4-.13-.57.13-.65.82-.79.99-.29.2-.54.07a6.64 6.64 0 0 1-1.95-1.2 7.28 7.28 0 0 1-1.34-1.67c-.14-.24 0-.37.1-.49.11-.11.24-.29.36-.43.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.43-.06-.13-.57-1.37-.78-1.88-.2-.49-.41-.42-.57-.43h-.48a.92.92 0 0 0-.67.31 2.83 2.83 0 0 0-.88 2.1c0 1.24.9 2.44 1.03 2.61.13.17 1.76 2.69 4.27 3.67.6.26 1.06.41 1.42.52.6.19 1.14.16 1.57.1.48-.07 1.49-.61 1.7-1.2.21-.59.21-1.09.15-1.2-.06-.11-.23-.17-.48-.3Z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-paper/10 mt-12 pt-6 text-center text-xs text-paper/40">
      <p>{t('footer.rights')}</p>
    </div>
  </div>
</footer>
