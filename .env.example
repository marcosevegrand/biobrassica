# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_HTTPS_MODE=proxy
DJANGO_LOG_LEVEL=INFO

# Public domains
WEBSITE_HOST=marcosevegrand.com
WEBSITE_ALLOWED_HOSTS=marcosevegrand.com,www.marcosevegrand.com
SHOP_HOST=loja.marcosevegrand.com
SHOP_ALLOWED_HOSTS=loja.marcosevegrand.com
ADMIN_HOST=admin.marcosevegrand.com
ADMIN_ALLOWED_HOSTS=admin.marcosevegrand.com
SHOP_BASE_URL=
TLS_CERT_NAME=
CERTBOT_EMAIL=you@example.com

# Example: keep biobrassica.pt canonical while still accepting marcosevegrand.com
# WEBSITE_HOST=biobrassica.pt
# WEBSITE_ALLOWED_HOSTS=biobrassica.pt,www.biobrassica.pt,marcosevegrand.com,www.marcosevegrand.com
# SHOP_HOST=loja.biobrassica.pt
# SHOP_ALLOWED_HOSTS=loja.biobrassica.pt,loja.marcosevegrand.com
# ADMIN_HOST=admin.biobrassica.pt
# ADMIN_ALLOWED_HOSTS=admin.biobrassica.pt,admin.marcosevegrand.com
# SHOP_BASE_URL=https://loja.biobrassica.pt
# TLS_CERT_NAME=biobrassica.pt

DEFAULT_FROM_EMAIL=Biobrassica <loja@marcosevegrand.com>
PAYMENT_PROVIDER=stripe

# Database
DB_NAME=biobrassica
DB_USER=biobrassica
DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# Stripe (required when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
STRIPE_PUBLISHABLE_KEY=

# Ifthenpay MB WAY (required when PAYMENT_PROVIDER=ifthenpay_mbway)
IFTHENPAY_API_BASE_URL=https://api.ifthenpay.com
IFTHENPAY_MBWAY_KEY=
IFTHENPAY_ANTI_PHISHING_KEY=

PAYMENTS_FORCE_DISABLED=0

# Email (e.g. Brevo SMTP)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587

# Staff notifications
STAFF_NOTIFICATION_EMAILS=admin@marcosevegrand.com
