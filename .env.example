APP_NAME=Biobrassica
APP_ENV=production
APP_DEBUG=false
APP_URL=https://biobrassica.pt
APP_KEY=
APP_TIMEZONE=Europe/Lisbon
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt

# cPanel: set this to your account web root when using the public_html bridge.
# Example: /home/YOUR_CPANEL_USER/public_html
APP_PUBLIC_PATH=

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_CPANEL_USER_biobrassica
DB_USERNAME=YOUR_CPANEL_USER_biobrassica
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
FILAMENT_FILESYSTEM_DISK=public
# Optional cPanel fallback: store public uploads directly in public_html/storage
# instead of relying on a symbolic link.
PUBLIC_DISK_ROOT=

MAIL_MAILER=smtp
MAIL_HOST=mail.biobrassica.pt
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=loja@biobrassica.pt
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=loja@biobrassica.pt
MAIL_FROM_NAME=Biobrassica

PRIMARY_DOMAIN=biobrassica.pt
SHOP_PATH=loja
ADMIN_PATH=admin

ADMIN_NAME=Biobrassica Admin
ADMIN_EMAIL=admin@biobrassica.pt
ADMIN_PASSWORD=
ADMIN_EMAILS=admin@biobrassica.pt

# IfThenPay SDK credentials. Request live/test keys from IfThenPay support.
IFTHENPAY_BACKOFFICE_KEY=
IFTHENPAY_ANTI_PHISHING_KEY=
IFTHENPAY_MBWAY_KEY=
IFTHENPAY_MULTIBANCO_KEY=
# After setting these, run: php artisan ifthenpay:register-webhooks

# Local/staging checkout testing without IfThenPay credentials.
# Ignored when APP_ENV=production.
PAYMENTS_FAKE_ENABLED=false
PAYMENTS_FAKE_AUTO_CONFIRM=true
