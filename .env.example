# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_HTTPS_MODE=proxy
DJANGO_LOG_LEVEL=INFO

# Public domains
PRIMARY_DOMAIN=biobrassica.pt
DOMAIN_ALIASES=marcosevegrand.com
CERTBOT_EMAIL=geral@biobrassica.pt
DEFAULT_FROM_EMAIL=Biobrassica <geral@biobrassica.pt>

# Database
DB_NAME=biobrassica
DB_USER=biobrassica
DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# Payment provider (stripe, ifthenpay_mbway, mbway_manual)
PAYMENT_PROVIDER=mbway_manual

# Stripe (required when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
STRIPE_PUBLISHABLE_KEY=

# Ifthenpay MB WAY (required when PAYMENT_PROVIDER=ifthenpay_mbway)
IFTHENPAY_API_BASE_URL=https://api.ifthenpay.com
IFTHENPAY_MBWAY_KEY=
IFTHENPAY_ANTI_PHISHING_KEY=

# Manual MB WAY (requires MB WAY number configured in the admin)

PAYMENTS_FORCE_DISABLED=0

# Email (e.g. Brevo SMTP)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587

# Staff notifications
STAFF_NOTIFICATION_EMAILS=geral@biobrassica.pt

# Initial admin bootstrap (optional, used by the admin runtime)
INITIAL_ADMIN_EMAIL=geral@biobrassica.pt
INITIAL_ADMIN_USERNAME=geral
INITIAL_ADMIN_PASSWORD=Biobrassica2015!
