# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_HTTPS_MODE=proxy
DJANGO_LOG_LEVEL=INFO

# Public domains
PRIMARY_DOMAIN=biobrassica.pt
DOMAIN_ALIASES=marcosevegrand.com
CERTBOT_EMAIL=geral@biobrassica.pt
DEFAULT_FROM_EMAIL=Biobrassica <geral@biobrassica.pt>

# Database
DB_NAME=biobrassica
DB_USER=biobrassica
DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# Payments are configured manually in the admin (apps.core.ShopSettings).
# Set this to 1 to disable payments shop-wide regardless of the admin toggle.
PAYMENTS_FORCE_DISABLED=0

# Email (e.g. Brevo SMTP)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587

# Staff notifications
STAFF_NOTIFICATION_EMAILS=geral@biobrassica.pt
