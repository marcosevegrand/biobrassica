{
  "include": ["backend"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "backend/staticfiles",
    "backend/media",
    "backend/.venv",
    ".venv"
  ],
  "typeCheckingMode": "standard",
  "reportMissingModuleSource": "none",
  "reportMissingImports": "none",
  "extraPaths": ["backend"],
  "venvPath": "backend",
  "venv": ".venv"
}
